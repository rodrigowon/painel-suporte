{
  "manifest_version": 3,
  "name": "Hayai Desk",
  "version": "1.3.0",
  "description": "Respostas rápidas com Smart Compose no TomTicket",

  "permissions": ["storage"],

  "host_permissions": [
    "https://console.tomticket.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://console.tomticket.com/*"],
      "js": ["fuzzy.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Hayai Desk",
    "default_icon": {
      "16":  "icons/16.png",
      "48":  "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "icons": {
    "16":  "icons/16.png",
    "48":  "icons/48.png",
    "128": "icons/128.png"
  }
}
